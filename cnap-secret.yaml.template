# SUPERSEDED -- kept only as a historical record of this specific
# attempt's failure (a plain Kubernetes `Secret` + `serviceClaims`
# referencing it directly via `secretKeyRef.name`): confirmed
# APPLICATION_INVALID_SECRET_REF, root-caused to CNAP's controller
# actually generating an intermediate `<webservice>-<claim>-bind` secret
# that `secretKeyRef.name` must reference instead of the raw `Secret`
# name used below. Separately, the `servicebinding.io` file-mount path
# (`/bindings/<claim>/<key>`) was never explicitly confirmed at the time
# either, only inferred from the CNCF servicebinding.io naming
# convention.
#
# There is no "restore this" step: the real, working mechanism is
# Comcast xVault, already wired into `cnap-webservice.yaml`'s
# `serviceClaims` block (type: env for the plain key=value secret, type:
# servicebinding.io for the file-shaped one, both binding a Vault PATH
# directly rather than a Kubernetes Secret object at all -- a different,
# more directly documented mechanism than this one ever was) -- see that
# file and `deploy-credentials/README.md` for the current priority order
# and what each key maps to.
#
# Confirmed against CNAP's own docs (cnap.comcast.net/cnap ->
# Microservices Journey -> Service Claim Types -> Secret Binding): a
# WebService's serviceClaims can only reference a Secret that a
# serviceClaims entry actually claims, and `type: servicebinding.io`
# mounts each key as a FILE under /bindings/<claim-name>/<key> -- see
# docker-entrypoint.sh, which copies these into the paths this app
# actually expects (/workspace/ccp_jira.env, /root/.netrc, etc).
apiVersion: v1
kind: Secret
metadata:
  name: release-agent-portal-files
  namespace: corenw-att
stringData:
  # Paste the full contents of each real file below, as a plain string
  # (YAML block scalar, hence the "|").
  ccp-jira-env: |
    <paste the full real contents of release-agent/ccp_jira.env here>
  gerrit-netrc: |
    <paste the full real contents of your gerrit.netrc here>
  gh-hosts-yml: |
    <paste the full real contents of ~/.config/gh/hosts.yml here>
  opencode-auth-json: |
    <paste the full real contents of ~/.local/share/opencode/auth.json here>
---
# Simple string values -- referenced individually via env[].valueFrom.secretKeyRef
# in cnap-webservice.yaml, not as mounted files.
apiVersion: v1
kind: Secret
metadata:
  name: release-agent-portal-config
  namespace: corenw-att
stringData:
  portal-admin-password: "<a real, random admin password>"
  portal-user-password: "<a real, random user password>"
  portal-session-secret: "<a real random string -- e.g. `python3 -c \"import secrets; print(secrets.token_hex(32))\"`>"
  # Interim: your own identity, not a real service account yet -- see
  # DESIGN.md "Credential status". Swap to a dedicated bot identity once
  # one exists.
  git-author-name: "<your name>"
  git-author-email: "<your email>"
