# Node (frontend)
node_modules/
dist/
*.log

# Python (backend)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ruff_cache/

# macOS
.DS_Store
._*

# VS Code
.vscode/

# Env files -- credentials are passed as env vars at `docker compose up`
# time (see docker-compose.yml's own comments) or mounted from files
# outside this repo, never committed here.
*.env
.env*

# The real, filled-in version of the CNAP secrets manifest -- only the
# .template (placeholders only) is ever tracked.
cnap-secret.yaml

# deploy-credentials/ -- real credential files staged here as a
# temporary last-resort fallback (see that directory's own README.md).
# ccp_jira.env is already covered by *.env above; these are the other
# three. Never commit the real files.
deploy-credentials/gerrit.netrc
deploy-credentials/gh-hosts.yml
deploy-credentials/opencode-auth.json
